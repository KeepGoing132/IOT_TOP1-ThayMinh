# =============================================================================
# CẤU HÌNH BLYNK IOT CHO HỆ THỐNG AIOT BÁO CHÁY
# =============================================================================
# Điền mã Auth Token lấy từ Device trên Blynk Console (https://blynk.cloud)
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here

# Máy chủ Blynk Cloud (mặc định blynk.cloud)
BLYNK_SERVER=blynk.cloud

# Mã Event code để bắn Push Notification về điện thoại (tạo trong tab Events của Template)
BLYNK_EVENT_CODE=fire_alert

# Các chân ảo (Virtual Pins) trên Blynk App
# V0: Trạng thái còi/đèn (0 = Bình thường, 1 = Cháy)
# V1: Dòng chữ trạng thái (Label Widget)
# V2: Nồng độ khói PM2.5 (Tùy chọn)
BLYNK_PIN_STATUS=v0
BLYNK_PIN_LABEL=v1
BLYNK_PIN_PM25=v2
